# Copy this file to ".env" (which is gitignored) and fill in real values.
# docker-compose.yml reads these to configure Postgres credentials and the
# JWT signing secret -- none of the actual secrets are committed to git.

POSTGRES_DB=articleshare
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-to-a-strong-password

# Generate a long random value, e.g.: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string

JWT_EXPIRATION_MINUTES=1440
FRONTEND_PORT=80

# Optional: if `docker compose build` hangs/fails downloading Maven dependencies
# (Maven Central is slow or blocked from your network), set this to a mirror and
# rebuild, e.g.:
# MAVEN_MIRROR_URL=https://maven.aliyun.com/repository/public
MAVEN_MIRROR_URL=
